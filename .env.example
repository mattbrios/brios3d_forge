# Banco (docker-compose.yml e api/)
DB_HOST=localhost
DB_PORT=5432
DB_USER=forge
DB_PASSWORD=forge
DB_NAME=forge
# Banco usado pelos testes e2e (criado automaticamente pelo `test:e2e`)
DB_NAME_TEST=forge_test

# API
PORT=3001
FRONTEND_URL=http://localhost:3000
# Cookie de sessão: em produção (https) deixe true ou remova a linha
SESSION_COOKIE_SECURE=false

# Primeiro admin, criado quando a API sobe se ainda não existir.
# Com ADMIN_PASSWORD vazio o seed é ignorado. Mínimo de 12 caracteres.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@brios3d.local
ADMIN_PASSWORD=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
