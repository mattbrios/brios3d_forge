# Copie para deploy/.env na máquina de produção e preencha. Nunca commite o .env.

# Domínios. Web e API precisam do mesmo domínio pai (ex.: app.seudominio.com e
# api.seudominio.com): o cookie de sessão é SameSite=Lax.
API_DOMAIN=api.seudominio.com
FRONTEND_URL=https://app.seudominio.com

# Banco. Gere a senha com: openssl rand -base64 24
DB_USER=forge
DB_PASSWORD=
DB_NAME=forge

# Primeiro admin, criado quando a API sobe se ainda não existir. Mínimo de 12 caracteres.
# Depois do primeiro login, pode deixar ADMIN_PASSWORD vazio.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Backup (deploy/backup.sh). Sem BACKUP_S3_URI o dump fica só na máquina.
BACKUP_S3_URI=s3://seu-bucket/forge
BACKUP_KEEP_DAYS=7
